# ============================================================
# .env.example
# - 무엇: .env 파일의 견본 (실제 값이 아닌 예시만 들어 있음)
# - 역할: 이 프로젝트를 실행하려면 어떤 환경 변수가 필요한지 알려 준다.
# - 누가: 처음 프로젝트를 받은 개발자가 이 파일을 복사해서 .env를 만든다.
#
# 사용법:
#   cp .env.example .env
#   그다음 .env 안의 값을 진짜 값으로 바꾼다.
#
# 주의:
#   - .env는 .gitignore에 들어 있어 커밋되지 않는다. (진짜 비밀번호는 .env에만!)
#   - 이 파일(.env.example)은 커밋된다. 여기에는 절대 진짜 비밀번호를 쓰지 않는다.
#   - 형식은 KEY=VALUE 한 줄씩. = 앞뒤에 공백을 넣지 않는다.
#   - 이 파일은 docker-compose.yml 과 Spring(application.properties) 둘 다 읽는다.
# ============================================================

# MySQL root(관리자) 계정 비밀번호 — docker-compose.yml 에서만 사용
DB_ROOT_PASSWORD=change-me-root-password

# 서버(Spring)가 DB에 접속할 때 쓰는 일반 계정
DB_USERNAME=bank_open_api_user
DB_PASSWORD=change-me-app-password

# JWT(로그인 토큰) 서명용 비밀 키 — Spring(application.properties)에서 사용
# HS256 방식이라 32바이트(영문·숫자 32자) 이상이어야 한다. 짧으면 서버가 시작되지 않는다.
# 무작위 값 만들기 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# bank_core(계좌·이체 코어 시스템) 연동 — Spring(application.properties)에서 사용
# 주소: 비워 두면 기본값 http://localhost:8080
BANK_CORE_BASE_URL=http://localhost:8080
# bank_core에 만들어 둔 "연동 전용 회원"의 아이디·비밀번호 (bank_core member 테이블, role=USER)
# 이 회원이 주인인 계좌만 조회된다. 관리자(admin) 계정은 모든 계좌가 보이므로 쓰지 않는다.
BANK_CORE_USERNAME=open-api-integration
BANK_CORE_PASSWORD=change-me-bank-core-password
